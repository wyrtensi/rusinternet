www.rusinternet.com {
	redir https://rusinternet.com{uri} permanent
}

rusinternet.com {
	# /opt/rusinternet/site/current is a symlink the updater swaps atomically.
	root * /srv/rusinternet/current

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# The page CSP is a <meta> tag; frame-ancestors only works as a header.
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}

	# iOS offers to install a profile only with this type.
	@mobileconfig path *.mobileconfig
	header @mobileconfig Content-Type "application/x-apple-aspen-config"

	@scripts path *.sh *.cmd
	header @scripts Content-Type "text/plain; charset=utf-8"

	# The visit counter (wyrtensi/stats, deploy/server) is reached through the site
	# itself, so pages load scripts only from their own origin. Only the
	# script and the count endpoint pass; the dashboard stays on its own host.
	@counter path /stats/count /stats/count.js
	handle @counter {
		uri replace /stats/ /admin/
		reverse_proxy goatcounter:8080 {
			header_up Host stats.wyrtensi.ru
		}
	}

	file_server

	handle_errors {
		@missing expression {err.status_code} == 404
		handle @missing {
			rewrite * /404.html
			file_server
		}
	}

	# Access log without IP addresses (and without forwarded-for or cookie
	# headers); stats.wyrtensi.ru counts bots from these lines by User-Agent.
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>remote_ip delete
				request>client_ip delete
				request>remote_port delete
				request>headers>X-Forwarded-For delete
				request>headers>X-Real-Ip delete
				request>headers>Cookie delete
			}
		}
	}
}
