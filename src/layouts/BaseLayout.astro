---
interface Props {
  title: string;
  description: string;
  locale?: 'ru' | 'en';
  canonical?: string;
}

const {
  title,
  description,
  locale = 'ru',
  canonical = locale === 'ru' ? 'https://rusinternet.com/' : 'https://rusinternet.com/en/'
} = Astro.props;
const homeHref = locale === 'ru' ? '/' : '/en/';
const hasLanguageAlternate = canonical === 'https://rusinternet.com/' || canonical === 'https://rusinternet.com/en/';
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f7fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1220" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    {hasLanguageAlternate && <link rel="alternate" hreflang="ru" href="https://rusinternet.com/" />}
    {hasLanguageAlternate && <link rel="alternate" hreflang="en" href="https://rusinternet.com/en/" />}
    {hasLanguageAlternate && <link rel="alternate" hreflang="x-default" href="https://rusinternet.com/" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RusInternet" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={homeHref} aria-label="RusInternet">
        <span class="brand-mark" aria-hidden="true">R</span>
        <span>RusInternet</span>
      </a>
      <nav aria-label={locale === 'ru' ? 'Основная навигация' : 'Main navigation'}>
        <a href={`${homeHref}#how`}>{locale === 'ru' ? 'Как это работает' : 'How it works'}</a>
        <a href={`${homeHref}#safety`}>{locale === 'ru' ? 'Безопасность' : 'Safety'}</a>
        <a href={`${homeHref}#faq`}>FAQ</a>
      </nav>
      <div class="header-actions">
        <a class="language" href={locale === 'ru' ? '/en/' : '/'}>{locale === 'ru' ? 'EN' : 'RU'}</a>
        <button class="icon-button" id="theme-toggle" type="button" aria-label={locale === 'ru' ? 'Сменить тему' : 'Change theme'}>
          <span aria-hidden="true">◐</span>
        </button>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div><strong>RusInternet</strong><p>{locale === 'ru' ? 'Открытый помощник по установке сертификатов.' : 'An open helper for certificate installation.'}</p></div>
      <div class="footer-links">
        <a href={`${homeHref}#safety`}>{locale === 'ru' ? 'Безопасность' : 'Safety'}</a>
        <a href="/downloads/manifest.json">Manifest</a>
        <a href="/.well-known/security.txt">security.txt</a>
      </div>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
      button?.addEventListener('click', () => {
        const current = document.documentElement.dataset.theme;
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const next = current ? (current === 'dark' ? 'light' : 'dark') : (systemDark ? 'light' : 'dark');
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    </script>
  </body>
</html>

<style is:global>
  :root { color-scheme: light dark; --bg:#f6f8fb; --surface:#fff; --soft:#eef2f8; --text:#101828; --muted:#667085; --line:#e2e7ef; --blue:#2563eb; --blue2:#1d4ed8; --green:#12a463; --shadow:0 8px 26px rgba(16,24,40,.05); --shadow-sm:0 4px 14px rgba(16,24,40,.05); --radius:15px; --radius-sm:11px; --radius-xs:9px; font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
  :root[data-theme="dark"] { color-scheme:dark; --bg:#0a1120; --surface:#111a2c; --soft:#172238; --text:#f5f7ff; --muted:#a4b0c5; --line:#26344c; --blue:#6b96ff; --blue2:#89abff; --green:#33c987; --shadow:0 12px 34px rgba(0,0,0,.28); --shadow-sm:0 5px 16px rgba(0,0,0,.24); }
  @media (prefers-color-scheme:dark) { :root:not([data-theme]) { color-scheme:dark; --bg:#0a1120; --surface:#111a2c; --soft:#172238; --text:#f5f7ff; --muted:#a4b0c5; --line:#26344c; --blue:#6b96ff; --blue2:#89abff; --green:#33c987; --shadow:0 12px 34px rgba(0,0,0,.28); --shadow-sm:0 5px 16px rgba(0,0,0,.24); } }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body { margin:0; background:var(--bg); color:var(--text); min-width:320px; }
  a { color:inherit; }
  button,a { -webkit-tap-highlight-color:transparent; }
  :focus-visible { outline:3px solid color-mix(in srgb,var(--blue) 45%,transparent); outline-offset:3px; }
  .site-header { max-width:1120px; margin:auto; height:64px; padding:0 24px; display:flex; align-items:center; gap:30px; }
  .brand { display:flex; align-items:center; gap:10px; font-weight:780; text-decoration:none; font-size:18px; letter-spacing:-.3px; }
  .brand-mark { width:30px; height:30px; display:grid; place-items:center; color:white; background:linear-gradient(145deg,var(--blue),#55a1ff); border-radius:var(--radius-xs); font-size:15px; font-weight:850; box-shadow:0 5px 12px color-mix(in srgb,var(--blue) 22%,transparent); }
  nav { display:flex; gap:26px; margin-left:auto; }
  nav a,.footer-links a { color:var(--muted); text-decoration:none; font-size:14px; }
  nav a:hover,.footer-links a:hover { color:var(--text); }
  .header-actions { display:flex; align-items:center; gap:8px; }
  .language,.icon-button { min-width:37px; height:37px; border:1px solid var(--line); background:var(--surface); border-radius:var(--radius-sm); display:grid; place-items:center; text-decoration:none; font-size:13px; color:var(--text); transition:border-color .15s,background .15s; }
  .language:hover,.icon-button:hover { border-color:color-mix(in srgb,var(--blue) 40%,var(--line)); }
  .icon-button { cursor:pointer; font-size:18px; }
  footer { max-width:1120px; margin:64px auto 0; border-top:1px solid var(--line); padding:26px 24px 40px; display:flex; justify-content:space-between; gap:30px; }
  footer p { color:var(--muted); font-size:14px; margin:7px 0 0; }
  .footer-links { display:flex; gap:22px; align-items:flex-start; }
  @media(max-width:760px){ .site-header{height:58px;padding:0 16px}.site-header nav{display:none}.brand{font-size:17px}.header-actions{margin-left:auto}footer{margin-top:48px;flex-direction:column;padding:24px 18px 32px}.footer-links{flex-wrap:wrap} }
</style>
