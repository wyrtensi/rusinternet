---
interface Props {
  title: string;
  description: string;
  locale?: 'ru' | 'en';
  canonical?: string;
}

const {
  title,
  description,
  locale = 'ru',
  canonical = locale === 'ru' ? 'https://rusinternet.com/' : 'https://rusinternet.com/en/'
} = Astro.props;
const homeHref = locale === 'ru' ? '/' : '/en/';
const brand = locale === 'ru' ? 'Доступ в российский интернет' : 'Access to the Russian internet';
const hasLanguageAlternate = canonical === 'https://rusinternet.com/' || canonical === 'https://rusinternet.com/en/';
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f6f8fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b1e26" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    {hasLanguageAlternate && <link rel="alternate" hreflang="ru" href="https://rusinternet.com/" />}
    {hasLanguageAlternate && <link rel="alternate" hreflang="en" href="https://rusinternet.com/en/" />}
    {hasLanguageAlternate && <link rel="alternate" hreflang="x-default" href="https://rusinternet.com/" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={homeHref} aria-label={brand}>
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 64 64" width="30" height="30">
            <defs><clipPath id="bm"><circle cx="32" cy="32" r="23"/></clipPath></defs>
            <g clip-path="url(#bm)">
              <rect x="9" y="9" width="46" height="15.34" fill="#ffffff"/>
              <rect x="9" y="24.33" width="46" height="15.34" fill="#1746c9"/>
              <rect x="9" y="39.66" width="46" height="15.34" fill="#d62718"/>
              <g fill="none" stroke="#0b1633" stroke-opacity=".22" stroke-width="1.3">
                <ellipse cx="32" cy="32" rx="11" ry="23"/><line x1="32" y1="9" x2="32" y2="55"/>
                <path d="M12 20 H52 M9.5 32 H54.5 M12 44 H52"/>
              </g>
            </g>
            <circle cx="32" cy="32" r="23" fill="none" stroke="var(--line)" stroke-width="2"/>
          </svg>
        </span>
        <span class="brand-text">{brand}</span>
      </a>
      <nav aria-label={locale === 'ru' ? 'Основная навигация' : 'Main navigation'}>
        <a href={`${homeHref}#how`}>{locale === 'ru' ? 'Как это работает' : 'How it works'}</a>
        <a href={`${homeHref}#safety`}>{locale === 'ru' ? 'Безопасность' : 'Safety'}</a>
        <a href={`${homeHref}#faq`}>FAQ</a>
      </nav>
      <div class="header-actions">
        <a class="language" href={locale === 'ru' ? '/en/' : '/'}>{locale === 'ru' ? 'EN' : 'RU'}</a>
        <button class="icon-button" id="theme-toggle" type="button" aria-label={locale === 'ru' ? 'Сменить тему' : 'Change theme'}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
        </button>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div><strong>{brand}</strong><p>{locale === 'ru' ? 'Открытый помощник по установке доверенных сертификатов.' : 'An open helper for installing trusted certificates.'}</p></div>
      <div class="footer-links">
        <a href={`${homeHref}#safety`}>{locale === 'ru' ? 'Безопасность' : 'Safety'}</a>
        <a href="/downloads/manifest.json">Manifest</a>
        <a href="/.well-known/security.txt">security.txt</a>
      </div>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
      button?.addEventListener('click', () => {
        const current = document.documentElement.dataset.theme;
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const next = current ? (current === 'dark' ? 'light' : 'dark') : (systemDark ? 'light' : 'dark');
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
      });

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll('[data-reveal]');
      if (reduce || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('in'));
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) { entry.target.classList.add('in'); io.unobserve(entry.target); }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
        targets.forEach((el) => io.observe(el));
      }

      document.querySelectorAll('[data-reveal-blur]').forEach((el) => {
        el.setAttribute('role', 'button');
        el.setAttribute('tabindex', '0');
        const show = () => el.classList.add('shown');
        el.addEventListener('click', show);
        el.addEventListener('keydown', (event) => {
          const key = (event as KeyboardEvent).key;
          if (key === 'Enter' || key === ' ') { event.preventDefault(); show(); }
        });
      });
    </script>
  </body>
</html>

<style is:global>
  :root { color-scheme: light dark; --bg:#f6f8fb; --surface:#fff; --soft:#eef2f8; --text:#101828; --muted:#5f6b7f; --line:#e2e7ef; --blue:#2563eb; --blue2:#1d4ed8; --green:#12a463; --shadow:0 8px 26px rgba(16,24,40,.05); --shadow-sm:0 4px 14px rgba(16,24,40,.05); --radius:15px; --radius-sm:11px; --radius-xs:9px; font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
  :root[data-theme="dark"] { color-scheme:dark; --bg:#1b1e26; --surface:#242832; --soft:#2c313c; --text:#e9ebf1; --muted:#9ca4b3; --line:#343a46; --blue:#5f83e6; --blue2:#7a9aee; --green:#53bd8a; --shadow:0 12px 30px rgba(0,0,0,.22); --shadow-sm:0 4px 14px rgba(0,0,0,.18); }
  @media (prefers-color-scheme:dark) { :root:not([data-theme]) { color-scheme:dark; --bg:#1b1e26; --surface:#242832; --soft:#2c313c; --text:#e9ebf1; --muted:#9ca4b3; --line:#343a46; --blue:#5f83e6; --blue2:#7a9aee; --green:#53bd8a; --shadow:0 12px 30px rgba(0,0,0,.22); --shadow-sm:0 4px 14px rgba(0,0,0,.18); } }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body { margin:0; background:var(--bg); color:var(--text); min-width:320px; -webkit-text-size-adjust:100%; }
  a { color:inherit; }
  button,a { -webkit-tap-highlight-color:transparent; }
  img,svg { max-width:100%; }
  :focus-visible { outline:3px solid color-mix(in srgb,var(--blue) 45%,transparent); outline-offset:3px; }
  [astro-icon] { display:inline-block; }
  @media (prefers-reduced-motion: no-preference) {
    html.js [data-reveal] { opacity:0; transform:translateY(14px); transition:opacity .55s ease, transform .55s cubic-bezier(.2,.7,.2,1); }
    html.js [data-reveal].in { opacity:1; transform:none; }
    html.js .hero > * { animation:rise .6s cubic-bezier(.2,.7,.2,1) both; }
    html.js .hero .eyebrow { animation-delay:.03s } html.js .hero h1 { animation-delay:.09s }
    html.js .hero .hero-copy { animation-delay:.16s } html.js .hero .installer-card { animation-delay:.23s }
    html.js .hero .choose-label { animation-delay:.30s } html.js .hero .platforms { animation-delay:.34s }
    @keyframes rise { from { opacity:0; transform:translateY(12px) } to { opacity:1; transform:none } }
  }
  .site-header { max-width:1120px; margin:auto; height:64px; padding:0 24px; display:flex; align-items:center; gap:24px; }
  .brand { display:flex; align-items:center; gap:10px; font-weight:750; text-decoration:none; letter-spacing:-.2px; min-width:0; }
  .brand-mark { width:30px; height:30px; flex:none; display:grid; place-items:center; }
  .brand-text { font-size:15px; line-height:1.05; white-space:nowrap; }
  nav { display:flex; gap:24px; margin-left:auto; }
  nav a,.footer-links a { color:var(--muted); text-decoration:none; font-size:14px; }
  nav a:hover,.footer-links a:hover { color:var(--text); }
  .header-actions { display:flex; align-items:center; gap:8px; margin-left:auto; }
  nav ~ .header-actions { margin-left:0; }
  .language,.icon-button { min-width:37px; height:37px; border:1px solid var(--line); background:var(--surface); border-radius:var(--radius-sm); display:grid; place-items:center; text-decoration:none; font-size:13px; color:var(--text); cursor:pointer; transition:border-color .15s; }
  .language:hover,.icon-button:hover { border-color:color-mix(in srgb,var(--blue) 40%,var(--line)); }
  footer { max-width:1120px; margin:64px auto 0; border-top:1px solid var(--line); padding:26px 24px 40px; display:flex; justify-content:space-between; gap:30px; }
  footer strong { font-size:15px; }
  footer p { color:var(--muted); font-size:14px; margin:7px 0 0; max-width:360px; }
  .footer-links { display:flex; gap:22px; align-items:flex-start; }
  @media(max-width:820px){ nav{display:none} }
  @media(max-width:760px){ .site-header{height:58px;padding:0 16px;gap:12px} footer{margin-top:48px;flex-direction:column;padding:24px 18px 32px} .footer-links{flex-wrap:wrap} }
  @media(max-width:480px){ .brand-text{font-size:13px} }
  @media(max-width:360px){ .brand-text{font-size:12px} .site-header{gap:8px} }
</style>
