---
import { buildContentSecurityPolicy } from '../lib/csp';

interface Props {
  title: string;
  description: string;
  locale?: 'ru' | 'en';
  canonical?: string;
  scriptHashes?: string[];
  // Paths of the same page in both languages; hreflang is emitted only for real translations.
  alternates?: { ru: string; en: string };
  noindex?: boolean;
}

const site = 'https://rusinternet.com';
const {
  title,
  description,
  locale = 'ru',
  canonical = locale === 'ru' ? `${site}/` : `${site}/en/`,
  scriptHashes = [],
  alternates = canonical === `${site}/` || canonical === `${site}/en/` ? { ru: '/', en: '/en/' } : undefined,
  noindex = false
} = Astro.props;
const homeHref = locale === 'ru' ? '/' : '/en/';
const brand = locale === 'ru' ? 'Доступ в российский интернет' : 'Access to the Russian internet';
const languageHref = alternates ? (locale === 'ru' ? alternates.en : alternates.ru) : (locale === 'ru' ? '/en/' : '/');
const contentSecurityPolicy = buildContentSecurityPolicy(scriptHashes);
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {/* Ownership proofs for Google Search Console and Yandex Webmaster; removing them revokes access. */}
    <meta name="google-site-verification" content="_mRXue0pgJeVvSu01B6hHvdWtdfppyRtmwUcRKtwvB8" />
    <meta name="yandex-verification" content="348519ab6ce4ce38" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f6f8fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b1e26" media="(prefers-color-scheme: dark)" />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && alternates && <link rel="alternate" hreflang="ru" href={`${site}${alternates.ru}`} />}
    {!noindex && alternates && <link rel="alternate" hreflang="en" href={`${site}${alternates.en}`} />}
    {!noindex && alternates && <link rel="alternate" hreflang="x-default" href={`${site}${alternates.ru}`} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:image" content="https://rusinternet.com/social-preview.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={locale === 'ru' ? 'Российские сертификаты — безопасная установка' : 'Russian certificates — safe installation'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://rusinternet.com/social-preview.png" />
    <meta name="twitter:image:alt" content={locale === 'ru' ? 'Российские сертификаты — безопасная установка' : 'Russian certificates — safe installation'} />
    <title>{title}</title>
    <script is:inline src="/scripts/theme-init.js"></script>
  </head>
  <body>
    <div class="page-glow" aria-hidden="true"></div>
    <header class="site-header">
      <a class="brand" href={homeHref} aria-label={brand}>
        <span class="brand-mark" aria-hidden="true">
          <img src="/favicon.svg" alt="" width="30" height="30" />
        </span>
        <span class="brand-text">{brand}</span>
      </a>
      <nav aria-label={locale === 'ru' ? 'Основная навигация' : 'Main navigation'}>
        <a href={`${homeHref}#how`}>{locale === 'ru' ? 'Как это работает' : 'How it works'}</a>
        <a href={`${homeHref}#safety`}>{locale === 'ru' ? 'Безопасность' : 'Safety'}</a>
        <a href={`${homeHref}#faq`}>FAQ</a>
      </nav>
      <div class="header-actions">
        <a class="github-link" href="https://github.com/wyrtensi/rusinternet" target="_blank" rel="noopener" aria-label={locale === 'ru' ? 'Исходный код на GitHub' : 'Source code on GitHub'} title={locale === 'ru' ? 'Исходный код на GitHub' : 'Source code on GitHub'}>
          <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>
          <span class="github-label">GitHub</span>
        </a>
        <a class="language" href={languageHref} hreflang={locale === 'ru' ? 'en' : 'ru'}>{locale === 'ru' ? 'EN' : 'RU'}</a>
        <button class="icon-button" id="theme-toggle" type="button" aria-label={locale === 'ru' ? 'Сменить тему' : 'Change theme'}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
        </button>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div class="footer-top">
        <div class="footer-brand"><strong>{brand}</strong><p>{locale === 'ru' ? 'Открытый помощник по установке доверенных сертификатов.' : 'An open helper for installing trusted certificates.'}</p></div>
        <nav class="footer-links" aria-label={locale === 'ru' ? 'Ссылки' : 'Links'}>
          <a href={`${homeHref}#safety`}>{locale === 'ru' ? 'Безопасность' : 'Safety'}</a>
          <a href="https://github.com/wyrtensi/rusinternet" target="_blank" rel="noopener">{locale === 'ru' ? 'Открытый код' : 'Open source'}</a>
          <a href="https://www.gosuslugi.ru/crt" target="_blank" rel="noopener">{locale === 'ru' ? 'Официальный источник' : 'Official source'}</a>
          <a href="mailto:wyrtensi@gmail.com">{locale === 'ru' ? 'Контакты' : 'Contact'}</a>
        </nav>
      </div>
      <div class="footer-fine">
        <p>{locale === 'ru' ? 'Независимый некоммерческий проект. Не связан с Госуслугами, Минцифры России, госорганами и банками и не является их официальным ресурсом.' : 'An independent, non-commercial project. Not affiliated with Gosuslugi, the Russian Ministry of Digital Development, any government body or bank, and not an official resource of theirs.'}</p>
        <p>{locale === 'ru' ? 'Открытый исходный код: ' : 'Open source: '}<a href="https://github.com/wyrtensi/rusinternet" target="_blank" rel="noopener">github.com/wyrtensi/rusinternet</a>{locale === 'ru' ? '. Сертификаты взяты из официальной публикации Госуслуг (gu-st.ru), распространяются без изменений и сверены по SHA-256 (' : '. The certificates come from the official Gosuslugi publication (gu-st.ru), are redistributed unmodified and verified by SHA-256 ('}<a href="/downloads/manifest.json">{locale === 'ru' ? 'контрольные суммы' : 'checksums'}</a>{locale === 'ru' ? ') 28 августа 2026 года. Корневые действуют до 2032 и 2040 годов; набор периодически обновляется в проекте.' : ') on 28 August 2026. The roots are valid until 2032 and 2040; the set is updated periodically in this project.'}</p>
        <p>{locale === 'ru' ? 'Инструменты предоставляются «как есть», без гарантий. Установка меняет доверенные корневые сертификаты системы — выполняйте её по своему усмотрению; удалить их можно в любой момент.' : 'The tools are provided “as is”, without warranty. Installation changes your system’s trusted root certificates — do it at your own discretion; you can remove them at any time.'}</p>
        <p>{locale === 'ru' ? 'Сайт не собирает персональные данные и не ставит куки. Просмотры страниц считает наш собственный счётчик на нашем сервере, без сторонних сервисов; IP-адреса он не хранит. Для каждого просмотра сохраняются страница, время, источник перехода, страна, язык браузера, браузер и система — сводка открыта: ' : 'This site collects no personal data and sets no cookies. Page views are counted by our own counter on our own server, with no third-party services; it does not store IP addresses. For each view it keeps the page, the time, the referrer, the country, the browser language, the browser and the system; the summary is public: '}<a href="https://stats.wyrtensi.ru/" target="_blank" rel="noopener">stats.wyrtensi.ru</a>.</p>
      </div>
      <p class="footer-copy">© 2026 · rusinternet.com — {locale === 'ru' ? 'открытый некоммерческий проект' : 'an open, non-commercial project'}</p>
    </footer>
    <script is:inline src="/scripts/site.js" defer></script>
    {/* Visit counter: GoatCounter on our server, reached through this site (see github.com/wyrtensi/stats). */}
    <script is:inline src="/scripts/stats.js" defer></script>
    <script is:inline data-goatcounter="/stats/count" src="/stats/count.js" defer></script>
  </body>
</html>

<style is:global>
  :root { color-scheme: light dark; --bg:#f6f8fb; --surface:#fff; --soft:#eef2f8; --text:#101828; --muted:#5f6b7f; --line:#e2e7ef; --blue:#2563eb; --blue2:#1d4ed8; --green:#12a463; --shadow:0 8px 26px rgba(16,24,40,.05); --shadow-sm:0 4px 14px rgba(16,24,40,.05); --fl-white:rgba(255,255,255,.85); --fl-blue:rgba(0,57,166,.13); --fl-red:rgba(213,43,30,.10); --radius:15px; --radius-sm:11px; --radius-xs:9px; font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
  :root[data-theme="dark"] { color-scheme:dark; --bg:#1b1e26; --surface:#242832; --soft:#2c313c; --text:#e9ebf1; --muted:#9ca4b3; --line:#343a46; --blue:#5f83e6; --blue2:#7a9aee; --green:#53bd8a; --shadow:0 12px 30px rgba(0,0,0,.22); --shadow-sm:0 4px 14px rgba(0,0,0,.18); --fl-white:rgba(255,255,255,.07); --fl-blue:rgba(48,102,224,.20); --fl-red:rgba(226,66,52,.14); }
  @media (prefers-color-scheme:dark) { :root:not([data-theme]) { color-scheme:dark; --bg:#1b1e26; --surface:#242832; --soft:#2c313c; --text:#e9ebf1; --muted:#9ca4b3; --line:#343a46; --blue:#5f83e6; --blue2:#7a9aee; --green:#53bd8a; --shadow:0 12px 30px rgba(0,0,0,.22); --shadow-sm:0 4px 14px rgba(0,0,0,.18); --fl-white:rgba(255,255,255,.07); --fl-blue:rgba(48,102,224,.20); --fl-red:rgba(226,66,52,.14); } }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body { margin:0; background:var(--bg); color:var(--text); min-width:320px; -webkit-text-size-adjust:100%; }

  /* Decorative page top: the flag's three bands, tilted and heavily faded. */
  .page-glow { position:absolute; inset:0 0 auto; height:clamp(700px,96vh,1120px); z-index:-1; pointer-events:none; overflow:hidden; }
  .page-glow::before { content:''; position:absolute; inset:0; background:linear-gradient(192deg,var(--fl-white) 0%,var(--fl-white) 22%,var(--fl-blue) 40%,var(--fl-blue) 54%,var(--fl-red) 72%,var(--fl-red) 82%,transparent 96%); -webkit-mask-image:linear-gradient(180deg,#000 0%,#000 62%,transparent 100%); mask-image:linear-gradient(180deg,#000 0%,#000 62%,transparent 100%); }
  a { color:inherit; }
  button,a { -webkit-tap-highlight-color:transparent; }
  img,svg { max-width:100%; }
  :focus-visible { outline:3px solid color-mix(in srgb,var(--blue) 45%,transparent); outline-offset:3px; }
  [astro-icon] { display:inline-block; }
  @media (prefers-reduced-motion: no-preference) {
    html.js [data-reveal] { opacity:0; transform:translateY(14px); transition:opacity .55s ease, transform .55s cubic-bezier(.2,.7,.2,1); }
    html.js [data-reveal].in { opacity:1; transform:none; }
    html.js .hero > * { animation:rise .6s cubic-bezier(.2,.7,.2,1) both; }
    html.js .hero .eyebrow { animation-delay:.03s } html.js .hero h1 { animation-delay:.09s }
    html.js .hero .hero-copy { animation-delay:.16s } html.js .hero .installer-card { animation-delay:.23s }
    html.js .hero .choose-label { animation-delay:.30s } html.js .hero .platforms { animation-delay:.34s }
    @keyframes rise { from { opacity:0; transform:translateY(12px) } to { opacity:1; transform:none } }
  }
  /* The Wy Store banner comes in both themes; the file already matches the locale. */
  .wy-ad img { display:block; width:100%; height:auto; border-radius:var(--radius); border:1px solid var(--line); }
  .wy-ad img.on-dark { display:none; }
  .wy-ad:hover img { border-color:color-mix(in srgb,var(--blue) 34%,var(--line)); }
  :root[data-theme="dark"] .wy-ad img.on-dark { display:block; }
  :root[data-theme="dark"] .wy-ad img.on-light { display:none; }
  @media (prefers-color-scheme:dark) {
    :root:not([data-theme]) .wy-ad img.on-dark { display:block; }
    :root:not([data-theme]) .wy-ad img.on-light { display:none; }
  }
  .site-header { max-width:1120px; margin:auto; height:64px; padding:0 24px; display:flex; align-items:center; gap:24px; }
  .brand { display:flex; align-items:center; gap:10px; font-weight:750; text-decoration:none; letter-spacing:-.2px; min-width:0; }
  .brand-mark { width:30px; height:30px; flex:none; display:grid; place-items:center; }
  .brand-text { font-size:15px; line-height:1.05; white-space:nowrap; }
  nav { display:flex; gap:24px; margin-left:auto; }
  nav a,.footer-links a { color:var(--muted); text-decoration:none; font-size:14px; }
  nav a:hover,.footer-links a:hover { color:var(--text); }
  .header-actions { display:flex; align-items:center; gap:8px; margin-left:auto; }
  nav ~ .header-actions { margin-left:0; }
  .language,.icon-button { min-width:37px; height:37px; border:1px solid var(--line); background:var(--surface); border-radius:var(--radius-sm); display:grid; place-items:center; text-decoration:none; font-size:13px; color:var(--text); cursor:pointer; transition:border-color .15s; }
  .language:hover,.icon-button:hover { border-color:color-mix(in srgb,var(--blue) 40%,var(--line)); }
  .github-link { height:37px; padding:0 12px; border:1px solid var(--line); background:transparent; border-radius:var(--radius-sm); display:inline-flex; align-items:center; gap:6px; text-decoration:none; font-size:13px; color:var(--text); transition:border-color .15s,background-color .15s; }
  .github-link:hover,.github-link:focus-visible { background:var(--soft); border-color:color-mix(in srgb,var(--text) 28%,var(--line)); }
  footer { max-width:1120px; margin:64px auto 0; border-top:1px solid var(--line); padding:28px 24px 44px; }
  .footer-top { display:flex; justify-content:space-between; align-items:flex-start; gap:24px 40px; flex-wrap:wrap; }
  .footer-brand strong { font-size:15px; display:block; }
  .footer-brand p { color:var(--muted); font-size:14px; margin:6px 0 0; max-width:340px; }
  .footer-links { display:flex; gap:20px; flex-wrap:wrap; align-items:center; }
  .footer-fine { margin-top:24px; padding-top:20px; border-top:1px solid var(--line); display:grid; gap:9px; max-width:800px; }
  .footer-fine p { color:var(--muted); font-size:12.5px; line-height:1.55; margin:0; }
  .footer-fine a { color:var(--muted); text-decoration:underline; text-underline-offset:2px; text-decoration-color:color-mix(in srgb,var(--muted) 45%,transparent); }
  .footer-fine a:hover { color:var(--blue); text-decoration-color:var(--blue); }
  .footer-copy { margin:20px 0 0; color:var(--muted); font-size:12.5px; }
  @media(max-width:820px){ nav{display:none} }
  @media(max-width:760px){ .site-header{height:58px;padding:0 16px;gap:12px} footer{margin-top:48px;padding:24px 18px 32px} }
  @media(max-width:560px){ .github-link{width:37px;padding:0;justify-content:center} .github-label{display:none} }
  @media(max-width:560px){ .header-actions{flex:none} .brand-text{white-space:normal;line-height:1.12} }
  @media(max-width:480px){ .brand-text{font-size:13px} }
  @media(max-width:360px){ .brand-text{font-size:12px} .site-header{gap:8px} }
</style>
