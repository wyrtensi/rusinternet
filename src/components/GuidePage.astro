---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getInstallAction, type Locale, type Platform } from '../lib/platform';
import { INSTALLER_HASHES } from '../lib/release';

interface Props { platform: Platform; locale: Locale }
const { platform, locale } = Astro.props;
const ru = locale === 'ru';
const names: Record<Platform, string> = ru
  ? { windows:'Windows', macos:'macOS', android:'Android', ios:'iPhone и iPad', linux:'Linux' }
  : { windows:'Windows', macos:'macOS', android:'Android', ios:'iPhone and iPad', linux:'Linux' };
const name = names[platform];
const action = getInstallAction(platform, locale, INSTALLER_HASHES);
const paths = { ru: `/install/${platform}/`, en: `/en/install/${platform}/` };
const certGroups = ru
  ? [
      {
        title: 'Обязательно — для браузера',
        note: 'Одного корневого сертификата достаточно, чтобы браузер снова открывал российские сайты.',
        items: [['Russian Trusted Root CA — корневой', 'russian_trusted_root_ca.cer']]
      },
      {
        title: 'Рекомендуется — для надёжности',
        note: 'Добавьте, если сайт всё ещё не открывается: иногда сервер не передаёт промежуточный сертификат сам, и браузеру нужно взять его у вас.',
        items: [
          ['Russian Trusted Sub CA — промежуточный, 2022', 'russian_trusted_sub_ca.cer'],
          ['Russian Trusted Sub CA — промежуточный, 2024', 'russian_trusted_sub_ca_2024.cer']
        ]
      },
      {
        title: 'Только для ГОСТ-программ',
        note: 'Обычным браузерам не нужны — они не поддерживают ГОСТ. Ставьте, только если пользуетесь ГОСТ-софтом (например, КриптоПро).',
        items: [
          ['Минцифры России НУЦ корневой — ГОСТ 2025', 'russian_trusted_root_ca_gost_2025.cer'],
          ['Минцифры России НУЦ подчиненный — ГОСТ 2025', 'russian_trusted_sub_ca_gost_2025.cer']
        ]
      }
    ]
  : [
      {
        title: 'Required — for the browser',
        note: 'The root certificate alone is enough for the browser to open Russian sites again.',
        items: [['Russian Trusted Root CA — root', 'russian_trusted_root_ca.cer']]
      },
      {
        title: 'Recommended — as a safety net',
        note: 'Add these if a site still does not open: some servers do not send the intermediate certificate, and the browser has to take it from your device.',
        items: [
          ['Russian Trusted Sub CA — intermediate, 2022', 'russian_trusted_sub_ca.cer'],
          ['Russian Trusted Sub CA — intermediate, 2024', 'russian_trusted_sub_ca_2024.cer']
        ]
      },
      {
        title: 'Only for GOST software',
        note: 'Regular browsers do not need them because they do not support GOST. Install them only if you use GOST software such as CryptoPro.',
        items: [
          ['Ministry of Digital Development GOST root — 2025', 'russian_trusted_root_ca_gost_2025.cer'],
          ['Ministry of Digital Development GOST intermediate — 2025', 'russian_trusted_sub_ca_gost_2025.cer']
        ]
      }
    ];
const title = ru ? `Как установить сертификаты Минцифры на ${name}` : `Install Russian trusted certificates on ${name}`;
const description = ru
  ? `Как установить сертификаты Минцифры на ${name} и убрать ошибку «не защищено» на Госуслугах и в банках. Пошагово, с проверкой файлов.`
  : `How to install the Russian trusted certificates on ${name} and fix the “not secure” error on Russian government and bank sites. Step by step.`;
---
<BaseLayout {title} {description} {locale} canonical={`https://rusinternet.com${paths[locale]}`} alternates={paths}>
  <article class="guide">
    <a class="back" href={ru ? '/' : '/en/'}>{ru ? '← На главную' : '← Back to home'}</a>
    <span class="badge">{ru ? 'ИНСТРУКЦИЯ' : 'GUIDE'}</span>
    <h1>{ru ? `Установка на ${name}` : `Install on ${name}`}</h1>
    {platform === 'android' ? (
      <>
        {ru ? (
          <>
            <div class="notice"><strong>Почему Android просит подтверждение</strong><p>Начиная с Android 11 ни сайт, ни приложение не могут добавить центр сертификации незаметно — это встроенная защита. Установка занимает минуту и выполняется вручную в настройках. Обойти подтверждение безопасно нельзя, поэтому автоматического скрипта без root не существует.</p></div>
            <div class="chain-explainer"><strong>Зачем корневой и промежуточный сертификаты</strong><p>Сертификат сайта подписан промежуточным центром, а тот — корневым. Браузеру достаточно доверять <b>корневому</b>: промежуточный сайт обычно передаёт сам во время подключения. Но если сайт настроен неполно и не передаёт его, браузер не может достроить цепочку — тогда выручает заранее установленный <b>промежуточный</b>. Поэтому корневой обязателен, а промежуточные — подстраховка.</p></div>
            <ol>
              <li>Скачайте нужный сертификат ниже. Для браузера обязателен один — <b>Russian Trusted Root CA</b>.</li>
              <li>Откройте настройки телефона: <b>Установить сертификат → Сертификат ЦС</b> (в некоторых прошивках — «Сертификат CA») и выберите скачанный файл. Начиная с Android 11 открыть файл напрямую нельзя — только через настройки. Точный путь зависит от производителя:</li>
            </ol>
            <div class="vendor-paths">
              <div><span>Чистый Android, Pixel</span><small>Настройки → Безопасность и конфиденциальность → Другие настройки безопасности (в Android 12 и более ранних — «Дополнительно») → Шифрование и учётные данные → Установить сертификат → Сертификат ЦС</small></div>
              <div><span>Samsung (One UI)</span><small>Настройки → Безопасность и конфиденциальность → Другие параметры безопасности → Установить из хранилища устройства → Сертификат ЦС</small></div>
              <div><span>Xiaomi (HyperOS / MIUI)</span><small>Настройки → Пароли и безопасность → Конфиденциальность → Шифрование и учётные данные → Установить сертификат → Сертификат ЦС</small></div>
            </div>
            <ol start="3">
              <li>Подтвердите системное предупреждение и перезапустите браузер. Если сайт не открылся — добавьте рекомендуемые промежуточные сертификаты тем же способом.</li>
            </ol>
          </>
        ) : (
          <>
            <div class="notice"><strong>Why Android asks for confirmation</strong><p>Since Android 11, neither a website nor an app can add a certificate authority silently — this is built-in protection. Installation takes a minute and is done by hand in Settings. The confirmation cannot be bypassed safely, so no automatic script exists without root.</p></div>
            <div class="chain-explainer"><strong>Why a root and an intermediate certificate</strong><p>The site’s certificate is signed by an intermediate authority, which is signed by the root. The browser only needs to trust the <b>root</b>: a site normally sends the intermediate during the connection. If a site is misconfigured and does not send it, the browser cannot complete the chain — then a pre-installed <b>intermediate</b> helps. So the root is required and the intermediates are a safety net.</p></div>
            <ol>
              <li>Download the certificate you need below. The browser requires one — <b>Russian Trusted Root CA</b>.</li>
              <li>Open the phone’s Settings: <b>Install a certificate → CA certificate</b> and pick the downloaded file. Since Android 11 the file cannot be opened directly — only from Settings. The exact path depends on the manufacturer:</li>
            </ol>
            <div class="vendor-paths">
              <div><span>Stock Android, Pixel</span><small>Settings → Security &amp; privacy → More security &amp; privacy (on Android 12 and earlier — “Advanced”) → Encryption &amp; credentials → Install a certificate → CA certificate</small></div>
              <div><span>Samsung (One UI)</span><small>Settings → Security and privacy → Other security settings → Install from device storage → CA certificate</small></div>
              <div><span>Xiaomi (HyperOS / MIUI)</span><small>Settings → Passwords &amp; security → Privacy → Encryption &amp; credentials → Install a certificate → CA certificate</small></div>
            </div>
            <ol start="3">
              <li>Confirm the system warning and restart the browser. If the site still does not open, add the recommended intermediate certificates the same way.</li>
            </ol>
          </>
        )}
        <div class="cert-groups">
          {certGroups.map((g) => (
            <div class="cert-group">
              <div class="cert-group-head"><strong>{g.title}</strong><small>{g.note}</small></div>
              <div class="cert-list">{g.items.map(([label, file]) => <a href={`/downloads/certificates/${file}`} download><span class="cert-name">{label}</span><span class="dl">↓</span></a>)}</div>
            </div>
          ))}
        </div>
        {ru
          ? <div class="hint"><strong>Появится уведомление «Сеть может отслеживаться»</strong><p>Это стандартное сообщение Android для любого добавленного вами сертификата, а не ошибка. Удалить сертификат можно в любой момент в том же меню. Файлы совпадают с официальной публикацией Госуслуг — контрольные суммы есть в <a href="/downloads/manifest.json">manifest.json</a>. Chrome и браузеры на его основе используют добавленный центр сразу, Firefox — начиная с версии 120; некоторые приложения (например, банковские с привязкой сертификата) — нет, это ограничение самой системы, а не установки.</p></div>
          : <div class="hint"><strong>You will see “Network may be monitored”</strong><p>This is the standard Android notice for any certificate you add, not an error. You can remove the certificate at any time in the same menu. The files match the official Gosuslugi publication — checksums are in <a href="/downloads/manifest.json">manifest.json</a>. Chrome and Chromium-based browsers use the added authority right away, Firefox from version 120; some apps (for example, banking apps with certificate pinning) do not — that is a limit of the system, not of the installation.</p></div>}
      </>
    ) : platform === 'ios' ? (
      <>
        {ru
          ? <ol><li>Нажмите кнопку и разрешите загрузку профиля.</li><li>Откройте Настройки → Основные → VPN и управление устройством → Russian Trusted CA → Установить.</li><li>Затем: Настройки → Основные → Об этом устройстве → Настройки доверия сертификатов и включите полное доверие для «Russian Trusted Root CA».</li></ol>
          : <ol><li>Tap the button and allow the profile download.</li><li>Open Settings → General → VPN &amp; Device Management → Russian Trusted CA → Install.</li><li>Then: Settings → General → About → Certificate Trust Settings and turn on full trust for “Russian Trusted Root CA”.</li></ol>}
        {ru
          ? <div class="hint"><strong>Пометка «Не проверено» — это нормально</strong><p>Она значит лишь, что профиль не подписан, и остаётся после включения доверия. На работу сертификата это не влияет.</p></div>
          : <div class="hint"><strong>“Not Verified” is normal</strong><p>It only means the profile is unsigned, and it stays after you enable trust. It does not affect how the certificate works.</p></div>}
        <a class="primary" href={action.kind !== 'command' ? action.href : '#'}>{ru ? 'Установить профиль' : 'Install profile'}</a>
      </>
    ) : action.kind === 'command' ? (
      <>
        {ru
          ? <div class="notice"><strong>Команда проверяет установщик</strong><p>Сначала сверяется SHA-256 самого скрипта, затем скрипт проверяет все пять сертификатов перед изменением системы.</p></div>
          : <div class="notice"><strong>The command verifies the installer</strong><p>It first checks the SHA-256 of the script itself; the script then checks all five certificates before changing the system.</p></div>}
        {ru
          ? <ol><li>Откройте приложение «Терминал».</li><li>Скопируйте команду ниже, вставьте её и нажмите Enter.</li><li>{platform === 'linux' ? 'Введите свой пароль (команда sudo), если система попросит, затем перезапустите браузер.' : 'Введите пароль учётной записи администратора Mac, если система попросит, затем перезапустите браузер.'}</li></ol>
          : <ol><li>Open the Terminal app.</li><li>Copy the command below, paste it and press Enter.</li><li>{platform === 'linux' ? 'Enter your own password (sudo) if asked, then restart the browser.' : 'Enter the password of a Mac administrator account if asked, then restart the browser.'}</li></ol>}
        {platform === 'linux' && (ru
          ? <div class="hint"><strong>Firefox в Linux</strong><p>Firefox в Linux не берёт сертификаты из системы. Импортируйте корневой вручную: Настройки → Приватность и защита → Сертификаты → «Просмотр сертификатов» → «Центры сертификации» → «Импортировать» и отметьте «Доверять при идентификации веб-сайтов».</p></div>
          : <div class="hint"><strong>Firefox on Linux</strong><p>Firefox on Linux does not use the system certificates. Import the root manually: Settings → Privacy &amp; Security → Certificates → View Certificates → Authorities → Import, and tick “Trust this CA to identify websites”.</p></div>)}
        <div class="command"><code id="guide-command">{action.command}</code><button id="guide-copy" type="button" data-copied={ru ? 'Скопировано' : 'Copied'}>{ru ? 'Копировать' : 'Copy'}</button></div>
      </>
    ) : (
      <>
        {ru
          ? <ol><li>Скачайте установщик — файл install-windows.cmd.</li><li>Откройте файл и подтвердите запрос контроля учётных записей Windows.</li><li>Дождитесь сообщения Done и перезапустите браузер.</li></ol>
          : <ol><li>Download the installer — the install-windows.cmd file.</li><li>Open the file and confirm the Windows User Account Control prompt.</li><li>Wait for the Done message and restart the browser.</li></ol>}
        {ru
          ? <div class="hint"><strong>Если браузер или Windows предупреждают</strong><p>Браузер может написать, что такие файлы скачивают редко, — выберите «Сохранить» (в Edge: «…» → «Сохранить» → «Всё равно сохранить»). При запуске Windows может показать «Система Windows защитила ваш компьютер» — нажмите «Подробнее» → «Выполнить в любом случае». Так Windows реагирует на любой файл без цифровой подписи, это не признак вируса. Установщик — обычный текстовый файл: перед запуском его можно открыть в Блокноте и посмотреть, что он делает.</p></div>
          : <div class="hint"><strong>If the browser or Windows warns you</strong><p>The browser may say this file is not commonly downloaded — choose Keep (in Edge: … → Keep → Keep anyway). When you run it, Windows may show “Windows protected your PC” — click More info → Run anyway. Windows does this for any file without a digital signature; it is not a sign of a virus. The installer is a plain text file: you can open it in Notepad before running it to see what it does.</p></div>}
        <a class="primary" href={action.href} download>{ru ? 'Установить для Windows' : 'Install for Windows'}</a>
      </>
    )}
    {(platform === 'windows' || platform === 'macos' || platform === 'linux') && (
      <a class="manual-link" href={`${ru ? '/manual/' : '/en/manual/'}#${platform}`}>
        <strong>{ru ? 'Не хотите запускать установщик?' : 'Rather not run the installer?'}</strong>
        <span>{ru ? 'Установите сертификат вручную, через настройки системы →' : 'Install the certificate by hand in the system settings →'}</span>
      </a>
    )}
    <p class="footnote">{ru
      ? 'Набор сверен с официальной публикацией Госуслуг 28 августа 2026 года. Корневые сертификаты действуют до 2032 и 2040 годов; набор периодически обновляется в проекте.'
      : 'The set was checked against the official Gosuslugi publication on 28 August 2026. The roots are valid until 2032 and 2040; the set is updated periodically in this project.'}</p>
  </article>
  <script>
    import { copyTextAndSetLabel } from '../lib/clipboard';

    document.querySelector('#guide-copy')?.addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      const command = document.querySelector('#guide-command')?.textContent ?? '';
      await copyTextAndSetLabel(command, button, button.dataset.copied ?? 'Copied', navigator.clipboard);
    });
  </script>
</BaseLayout>
<style>
  .guide{max-width:720px;margin:44px auto 0;padding:0 22px}
  .back{color:var(--muted);font-size:13px;text-decoration:none}
  .badge{display:block;color:var(--blue);font-size:11px;font-weight:800;letter-spacing:.14em;margin-top:40px}
  h1{font-size:clamp(32px,5.2vw,50px);letter-spacing:-.04em;line-height:1.06;margin:12px 0 26px}
  .notice{background:var(--surface);border:1px solid var(--line);border-left:4px solid var(--blue);border-radius:var(--radius);padding:16px 18px;margin-bottom:24px}
  .notice p{color:var(--muted);line-height:1.55;font-size:14px;margin:7px 0 0}
  ol{padding-left:22px;display:grid;gap:14px;line-height:1.6;color:var(--muted)}
  ol b{color:var(--text)}
  li::marker{color:var(--blue);font-weight:800}
  .primary{display:flex;justify-content:center;align-items:center;background:var(--blue);color:white;text-decoration:none;font-weight:750;border-radius:var(--radius-sm);height:52px;margin-top:24px;transition:background .18s}
  .primary:hover{background:var(--blue2)}
  .command{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:12px;display:flex;gap:10px;align-items:stretch;margin-top:6px}
  .command code{background:var(--soft);padding:12px;border-radius:var(--radius-xs);word-break:break-all;font-size:11px;line-height:1.5;flex:1}
  .command button{border:0;border-radius:var(--radius-xs);background:var(--blue);color:white;padding:0 14px;font-weight:700;cursor:pointer}
  .cert-list{display:grid;gap:8px;margin-top:22px}
  .cert-list a{background:var(--surface);border:1px solid var(--line);padding:13px 16px;border-radius:var(--radius-sm);text-decoration:none;display:flex;align-items:center;gap:10px;font-size:14px;transition:border-color .15s}
  .cert-list a:hover{border-color:color-mix(in srgb,var(--blue) 38%,var(--line))}
  .cert-name{flex:1}
  .cert-list .tag{font-size:10px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--green);background:color-mix(in srgb,var(--green) 12%,var(--surface));border-radius:6px;padding:3px 7px}
  .cert-list .dl{color:var(--blue);font-weight:800}
  .hint{margin-top:22px;background:var(--soft);border-radius:var(--radius);padding:15px 18px}
  .hint strong{font-size:14px}
  .hint p{color:var(--muted);font-size:13px;line-height:1.55;margin:6px 0 0}
  .vendor-paths{display:grid;gap:8px;margin:14px 0 0}
  .vendor-paths>div{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-sm);padding:12px 14px}
  .vendor-paths>div span{display:block;font-size:13px;font-weight:650;margin-bottom:4px}
  .vendor-paths>div small{color:var(--muted);font-size:12.5px;line-height:1.5}
  .chain-explainer{background:var(--soft);border-radius:var(--radius);padding:16px 18px;margin:0 0 22px}
  .chain-explainer strong{font-size:14px}
  .chain-explainer p{color:var(--muted);font-size:14px;line-height:1.55;margin:7px 0 0}
  .chain-explainer b{color:var(--text)}
  .cert-groups{display:grid;gap:20px;margin-top:22px}
  .cert-group-head strong{font-size:14px;display:block}
  .cert-group-head small{color:var(--muted);font-size:13px;line-height:1.5;display:block;margin-top:3px}
  .cert-group .cert-list{margin-top:10px}
  .footnote{color:var(--muted);font-size:12px;margin-top:26px}
  .manual-link{display:block;margin-top:22px;border:1px dashed color-mix(in srgb,var(--blue) 45%,var(--line));border-radius:var(--radius);padding:14px 18px;text-decoration:none;transition:border-color .15s,background .15s}
  .manual-link:hover{border-color:var(--blue);background:color-mix(in srgb,var(--blue) 5%,var(--surface))}
  .manual-link strong{display:block;font-size:14px;color:var(--text)}
  .manual-link span{display:block;font-size:13px;color:var(--blue);margin-top:4px}
  @media(max-width:580px){.guide{margin-top:30px}.badge{margin-top:30px}.command{flex-direction:column}.command button{height:43px}}
</style>
